{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.test.{ts,tsx}", "!vitest.config.ts"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": ["NODE_ENV"],
      "passThroughEnv": ["NEXT_TELEMETRY_DISABLED", "NEXT_RUNTIME", "NEXT_PHASE"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "format:check": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_PASSWORD_FILE",
        "PORTLESS*",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_SECRET_FILE",
        "AUTH_TRUSTED_IP_HEADER",
        "AUTH_TRUSTED_PROXIES",
        "REDIS_URL",
        "REDIS_PASSWORD_FILE",
        "REDIS_KEY_PREFIX",
        "EMAIL_TRANSPORT",
        "EMAIL_FROM",
        "SMTP_URL",
        "RESEND_API_KEY",
        "RESEND_API_KEY_FILE",
        "MAILPIT_URL"
      ]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "DOCKER_*", "TESTCONTAINERS_*", "RYUK_*"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/compose.yaml", "$TURBO_ROOT$/docker/**"]
    }
  }
}
