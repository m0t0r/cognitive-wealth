{
  "name": "cognitive-wealth",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:env": "node packages/dev-env/src/cli/env.ts",
    "dev:teardown": "node packages/dev-env/src/cli/teardown.ts",
    "dev:prune": "node packages/cli/src/cli.ts dev prune",
    "lint": "oxlint && turbo run lint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt && turbo run format",
    "format:check": "oxfmt --check && turbo run format:check",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:integration": "node packages/testing/src/cli/with-postgres.ts turbo run test:integration",
    "test:watch": "turbo run test:watch",
    "e2e": "turbo run e2e",
    "test:coverage": "turbo run test:coverage",
    "dev:sign-in": "node packages/testing/src/cli/dev-sign-in.ts",
    "db:seed": "pnpm --filter @repo/households db:seed",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "custodian:ingest": "node packages/cli/src/cli.ts custodian ingest",
    "docs:diagrams": "node .claude/skills/pr-visual/scripts/render.mjs docs/diagrams --svg-only",
    "docs:diagrams:preview": "node .claude/skills/pr-visual/scripts/render.mjs docs/diagrams --png-dir .dev/diagrams",
    "org:create": "node packages/cli/src/cli.ts org create",
    "org:export": "node packages/cli/src/cli.ts org export",
    "org:deactivate": "node packages/cli/src/cli.ts org deactivate",
    "org:reactivate": "node packages/cli/src/cli.ts org reactivate",
    "cve:scan": "node packages/cve-scan/src/cli/scan.ts",
    "cw": "node packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint-plugin-turbo": "2.11.10",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
