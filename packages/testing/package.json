{
  "name": "@repo/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./vitest": "./src/vitest.ts",
    "./react": "./src/react.tsx",
    "./pglite": "./src/pglite.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run --project unit --project ui",
