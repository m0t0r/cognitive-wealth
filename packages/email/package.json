{
  "name": "@repo/email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./copy": "./src/copy.ts",
    "./testing": "./src/testing.ts",
    "./templates/*": "./src/templates/*.tsx"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "email dev --dir src/templates --port ${PORT:-3001}",
    "check-types": "tsc --noEmit",
    "test": "vitest run --project unit --project ui",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-email/render": "2.1.1",
    "nodemailer": "10.2.0",
    "react-email": "6.11.3",
    "resend": "6.34.1"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.3",
    "@repo/testing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "portless": "0.15.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "portless": {
    "name": "emails.cognitive-wealth",
    "script": "dev:app"
  }
}
