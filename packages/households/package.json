{
  "name": "@repo/households",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./world": "./src/world.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
