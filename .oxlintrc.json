{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y"],
  "jsPlugins": ["eslint-plugin-turbo", "./packages/lint-rules/src/index.ts"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "env": {
    "browser": true,
    "es2025": true
  },
  "settings": {
    "react": {
      "version": "19.3"
    },
    "next": {
      "rootDir": ["apps/web/"]
    },
    "jsx-a11y": {
      "components": {
        "Button": "button",
        "Input": "input",
        "Label": "label",
        "Textarea": "textarea"
      }
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest", "server-only"]
      }
    ],
    "turbo/no-undeclared-env-vars": "error",
    // Named arguments (CLAUDE.md, "Code conventions"): at most `db` (or `auth`) and one object.
    "max-params": ["error", { "max": 2 }],
    // ... and a parameter type of more than 3 members gets a name.
    "repo/max-inline-param-type-members": ["error", { "max": 3 }],
    // Every page under apps/web/app/(app)/ that renders renders <AppShellSync /> (docs/auth.md,
    // "Client navigation"); the rule checks the path itself.
    "repo/app-page-renders-shell-sync": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    // A `default:` doesn't count as covering a union, so adding a member fails the switch that
    // misses it.
    "typescript/switch-exhaustiveness-check": "error",
    // Only the case that's a bug: a promise returned from inside `try` without `await` skips its
    // `catch` and `finally`. Both styles are fine elsewhere.
    "typescript/return-await": ["error", "error-handling-correctness-only"],
    // `0` and `false` are values (an amount, a flag), so `||` mustn't replace them. Strings are
    // left out: an empty env var or `gh` field is meant to fall through to the default.
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true } }],
    // A number in a condition reads `0` as missing, and `0` is a real amount, quantity or count:
    // compare it (`> 0`, `!== undefined`) instead. Strings, nullable strings and nullable booleans
    // stay allowed for the reason above: `""` and `undefined` both mean "not given" (#274). An
    // object is never falsy, so a nullable one reads as a null check.
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowString": true,
        "allowNumber": false,
        "allowNullableObject": true,
        "allowNullableBoolean": true,
        "allowNullableString": true,
        "allowNullableNumber": false,
        "allowNullableEnum": false,
        "allowAny": false
      }
    ],
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/**"],
      "plugins": ["nextjs"]
    },
    {
      // Agent hooks and skill scripts run under Claude Code, not as Turborepo tasks.
      "files": [".claude/**"],
      // Named arguments aren't enforced there: hooks and skill scripts are the agent's own
      // guardrails, and migrating them needs the user's approval first (#127).
      "rules": {
        "turbo/no-undeclared-env-vars": "off",
        "max-params": "off",
        "repo/max-inline-param-type-members": "off",
        // Same reason, and they're untyped `.mjs`, where every JSON field is `any`.
        "typescript/strict-boolean-expressions": "off"
      }
    },
    {
      "files": ["apps/web-e2e/tests/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@playwright/test",
                "message": "Import test and expect from ../fixtures, so the test runs against its worker's isolated server and database.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/.next/**",
    "**/out/**",
    "**/build/**",
    "**/dist/**",
    "**/next-env.d.ts",
    ".agents/**",
    ".claude/worktrees/**",
    ".claude/skills/*",
    "!.claude/skills/before-and-after",
    "!.claude/skills/pr-visual",
    "!.claude/skills/verifier-web",
    "packages/design-system/src/components/**",
    "packages/design-system/src/hooks/**",
    "packages/design-system/src/lib/highlighter.tsx",
    "packages/custodian-client/src/generated/**"
  ]
}
