# `pnpm dev` against the dev Compose stack (see docs/dev-sign-in.md):
#   docker compose -f compose.yaml -f compose.dev.yaml up -d db migrate redis mailpit
#   cp apps/web/.env.example apps/web/.env.local
# Relative *_FILE paths resolve from apps/web, where `next dev` runs. No secret goes in this file:
# the *_FILE variables point at the generated files in .secrets/ (see compose.yaml).
# BETTER_AUTH_URL stays unset: outside production the app uses PORTLESS_URL, which portless sets.
# This is the main checkout's. A git worktree writes its own on `pnpm dev` (packages/dev-env), for
# its own database and Redis prefix on the verification services, so don't copy this one there.

# Postgres as the least-privilege `app` role (DML only), published on loopback by compose.dev.yaml.
DATABASE_URL=postgres://app@localhost:5432/cognitive_wealth
# The app role's password; it overrides any password in DATABASE_URL.
DATABASE_PASSWORD_FILE=../../.secrets/db_app_password

# Redis (rate-limit counters and the session cache) as its ACL user `app`.
REDIS_URL=redis://app@localhost:6379
REDIS_PASSWORD_FILE=../../.secrets/redis_password

# Mail goes to Mailpit over SMTP; read it at http://127.0.0.1:8025.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025

# Signs session cookies and tokens; the same secret as the Compose `web` service.
BETTER_AUTH_SECRET_FILE=../../.secrets/better_auth_secret

# Client IP for rate limits and audit events: portless appends the socket address to this header.
AUTH_TRUSTED_IP_HEADER=x-forwarded-for

# Mailpit's API, for the sign-in harness. It's the default; the harness reads it from the shell.
MAILPIT_URL=http://127.0.0.1:8025
