{
  "name": "custodian",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "portless",
    "dev:app": "uv run uvicorn custodian.main:app --reload --host ${HOST:-127.0.0.1} --port ${PORT:-8000}",
    "lint": "uv run ruff check",
    "format": "uv run ruff format",
    "format:check": "uv run ruff format --check",
    "check-types": "uv run pyright",
    "test": "uv run pytest --ignore=tests/integration",
    "test:integration": "uv run pytest tests/integration",
    "db:migrate": "uv run alembic upgrade head",
    "world:load": "uv run python -m custodian.load",
    "feed:write": "uv run python -m custodian.feed",
    "feed:examples": "uv run python -m tests.integration.example_deliveries",
    "world:schema": "uv run python -m custodian.world",
    "openapi:write": "uv run python -m custodian.main"
  },
  "devDependencies": {
    "portless": "0.15.8"
  },
  "portless": {
    "name": "custodian.cognitive-wealth",
    "script": "dev:app"
  }
}
