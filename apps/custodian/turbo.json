{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The custodian's integration tests start Postgres with Testcontainers (ADR 0011), so they
    // need the host's Docker settings, and they run the image compose.yaml pins.
    "test:integration": {
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*", "RYUK_*"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/compose.yaml"]
    }
  }
}
