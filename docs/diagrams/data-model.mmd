erDiagram
  user ||--o{ session : "signs in with"
  user ||--o{ account : "has"
  user ||--o{ member : "belongs through"
  organization ||--o{ member : "has"
  organization ||--o{ invitation : "sends"
  user ||--o{ invitation : "invites (inviter)"
  organization |o--o{ session : "is active in"
  organization |o--o{ session : "removed from"
  user |o--o{ audit_event : "acts in"
  organization |o--o{ audit_event : "scopes"
  organization ||--o{ household : "serves (firm_id)"
  organization ||--o{ person : "knows (firm_id)"
  organization ||--o{ custodial_account : "manages (firm_id)"
  household ||--o{ household_member : "has"
  person ||--o{ household_member : "belongs through"
  person ||--o{ account_role : "holds"
  custodial_account ||--o{ account_role : "is held through"
  organization ||--o| world_seed : "was seeded from"
  organization ||--o{ custodian_delivery : "ingested (firm_id)"
  organization ||--o{ security : "knows (firm_id)"
  custodian_delivery ||--o{ custodial_transaction : "carried"
  custodian_delivery ||--o{ custodial_position : "reported"
  custodian_delivery ||--o{ security_price : "priced"
  custodial_account ||--o{ custodial_transaction : "posted to"
  custodial_account ||--o{ custodial_position : "holds"
  security |o--o{ custodial_transaction : "traded in"
  security ||--o{ custodial_position : "held as"
  security ||--o{ security_price : "is priced by"

  user {
    bigint id PK
    uuid public_id UK
    text email UK "lowercase"
    text name
    bool email_verified
  }
  session {
    bigint id PK
    text token UK
    bigint user_id FK
    bigint active_organization_id FK "the tenant"
    bigint removed_from_organization_id FK "Removal notice"
    timestamptz expires_at
  }
  account {
    bigint id PK
    bigint user_id FK
    text provider_id
  }
  verification {
    bigint id PK
    text identifier "link or code key"
    text value
    timestamptz expires_at
  }
  organization {
    bigint id PK
    uuid public_id UK
    text name
    text slug UK
    timestamptz deactivated_at
  }
  member {
    bigint id PK
    uuid public_id UK
    bigint organization_id FK
    bigint user_id FK
    text role "owner, admin or member"
  }
  invitation {
    bigint id PK
    uuid public_id UK
    bigint organization_id FK
    bigint inviter_id FK
    text email
    text role
    text status
    timestamptz expires_at
  }
  audit_event {
    bigint id PK
    text action
    bigint actor_user_id FK
    bigint organization_id FK
    text target_type
    text target_id
    jsonb metadata
  }
  household {
    bigint id PK
    uuid public_id UK
    bigint firm_id FK
    text seed_key "world file key"
    text name
    text relationship_status "prospect, client or former_client"
  }
  person {
    bigint id PK
    uuid public_id UK
    bigint firm_id FK
    text seed_key "world file key"
    text first_name
    text last_name
    date born_on
  }
  household_member {
    bigint id PK
    uuid public_id UK
    bigint firm_id FK
    bigint household_id FK "same Firm"
    bigint person_id FK "same Firm"
    text role "one primary, at most one co_client"
  }
  custodial_account {
    bigint id PK
    uuid public_id UK
    bigint firm_id FK
    text account_number "unique per Firm"
    text registration_type "null until ingested"
    date opened_on "null until ingested"
  }
  account_role {
    bigint id PK
    uuid public_id UK
    bigint firm_id FK
    bigint person_id FK "same Firm"
    bigint account_id FK "same Firm"
    text role "owner, joint_owner, ..."
    date starts_on
  }
  world_seed {
    bigint id PK
    bigint firm_id FK, UK
    text world_hash "SHA-256 of the CRM half"
    timestamptz seeded_at
  }
  custodian_delivery {
    bigint id PK
    bigint firm_id FK
    date as_of_date "unique per Firm"
    text manifest_sha256 "the Manifest's Content hash"
    timestamptz arrived_at
  }
  security {
    bigint id PK
    uuid public_id UK
    bigint firm_id FK
    text identifier "unique per Firm"
    text kind "stock, fund, bond, cash_sweep"
  }
  custodial_transaction {
    bigint id PK
    uuid public_id UK
    bigint firm_id FK
    bigint delivery_id FK "same Firm"
    text transaction_id "the Custodian's, unique per Firm"
    bigint account_id FK "same Firm"
    bigint security_id FK "same Firm, null for cash"
    text kind "buy, sell, ..., reversal"
    text reverses "a transaction_id"
    numeric amount "Money, 2 places"
    date trade_date
    date settlement_date
    date posting_date "the Delivery's As-of date"
    timestamptz arrived_at
  }
  custodial_position {
    bigint id PK
    uuid public_id UK
    bigint firm_id FK
    bigint delivery_id FK "same Firm"
    bigint account_id FK "same Firm"
    bigint security_id FK "same Firm"
    date as_of_date
    numeric shares "6 places"
    numeric market_value "null without a price"
    timestamptz arrived_at
  }
  security_price {
    bigint id PK
    bigint firm_id FK
    bigint delivery_id FK "same Firm"
    bigint security_id FK "same Firm"
    date as_of_date
    numeric price "as quoted"
    timestamptz arrived_at
  }
