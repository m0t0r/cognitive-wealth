flowchart TB
  issue(["Task or issue<br/>ready-for-agent"]) --> wt["EnterWorktree<br/>branch from origin/dev,<br/>.env.local copied, pnpm install"]
  wt --> code["Change code and docs<br/>tests at the owning layer"]
  code --> checks["lint, format, check-types,<br/>test, test:integration, e2e"]
  checks --> verify{"reaches apps/web?"}
  verify -->|yes| vw["verifier-web<br/>production build, agent-browser,<br/>perf trace"]
  verify -->|no| pr
  vw --> pr["pr-visual<br/>diagrams, charts, screenshots"]
  pr --> fr["friction issues<br/>for what slowed the task"]
  fr --> review(["Review and merge into dev"])

  guard["require-worktree hook<br/>denies edits in the main checkout"] -.-> wt
